{
  "name": "@dx/glob-hash",
  "version": "0.1.1",
  "exports": "./src/mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "test": "deno test --allow-read=. --allow-write=.",
    "update": "deno outdated --update --latest"
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "tests",
      ".gitignore",
      ".editorconfig"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 360,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      ".github",
      ".vscode"
    ]
  }
}
